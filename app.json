{
  "expo": {
    "name": "Продукты",
    "slug": "product",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "product",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.anonymous.product"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.product",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1677FF"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
